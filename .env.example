# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# Supabase > Connect > Direct tab > Transaction pooler (port 6543). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase > Connect > Framework tab, or Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Project Settings > API Keys > Secret keys. Server only: bypasses storage policies.
SUPABASE_SECRET_KEY=sb_secret_...

# Public origin of the site, used for canonical URLs, the sitemap and structured data.
# Production example: https://www.example.com. On Vercel the production domain is used if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
