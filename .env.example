# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# Supabase > Connect > Direct tab > Transaction pooler (port 6543). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase > Connect > Framework tab, or Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Project Settings > API Keys > Secret keys. Server only: bypasses storage policies.
SUPABASE_SECRET_KEY=sb_secret_...

# The one person allowed into /admin. Must be the email of the user you create in Supabase
# (Authentication > Users). Every admin check fails until this is set.
ADMIN_EMAIL=

# Contact form (all optional in development).
# Cloudflare Turnstile (dash.cloudflare.com > Turnstile). In production the secret is REQUIRED:
# without it the form refuses messages rather than accepting unchecked ones.
# For local testing use Cloudflare's dummy keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend (resend.com). Without both of these, messages are stored but not emailed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Shown as a clickable address on the Contact page. Leave blank to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=
# Must be a sender Resend has verified; the default works only for testing.
CONTACT_FROM_EMAIL=
# Messages allowed per visitor per hour (default 5).
CONTACT_RATE_LIMIT_MAX=

# Public origin of the site, used for canonical URLs, the sitemap and structured data.
# Production example: https://www.example.com. On Vercel the production domain is used if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
